    "build:installer": "node scripts/build-installer.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.63.0",
    "rcedit": "^5.0.2",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "fast-xml-parser": "^5.11.1"
  }
}
