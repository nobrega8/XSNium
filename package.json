{
  "name": "xsnium",
  "version": "0.2.0",
  "private": true,
  "license": "MPL-2.0",
  "type": "module",
  "description": "Legacy InfoPath (.xsn) compatibility runtime",
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "xsnium": "./src/cli/main.ts"
  },
  "scripts": {
