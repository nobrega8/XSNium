+/*
+ * XSNium: Internet Explorer lays out the InfoPath forms XSNium shows in whole pixels at 96 DPI, with the line
+ * metrics of GDI (the font's OS/2 win ascent and descent, no leading). It rounds the font's size to pixels, then
+ * its ascent and descent: Calibri 10pt is 13px, a line of 12 + 3, where Writer's metrics give 16.3px. Lines
+ * laid out with Writer's metrics drift from the form's design by a fraction of a pixel each.
+ */
+bool SwFntObj::GetPixelLineMetrics( const SwViewShell *pSh, const OutputDevice& rOut, sal_uInt16& rAscent,
+                                    sal_uInt16& rHeight )
+{
+    if ( !pSh || !pSh->getIDocumentSettingAccess().get( DocumentSettingId::PIXEL_LINE_METRICS ) )
+        return false;
+    const OutputDevice& rRefDev = pSh->GetRefDev();
+    if ( m_nPrtWinAscent == USHRT_MAX )
+    {
+        CreatePrtFont( rOut );
+        const vcl::Font aOldFnt( rRefDev.GetFont() );
+        const_cast<OutputDevice&>(rRefDev).SetFont( *m_pPrtFont );
+        tools::Long nAscent = 0, nDescent = 0;
+        if ( !vcl::font::GetWinLineMetrics( rRefDev, nAscent, nDescent ) )
+        {
+            // No win metrics: the font's usual ones, without leading.
+            const FontMetric aOutMet( rRefDev.GetFontMetric() );
+            nAscent = aOutMet.GetAscent();
+            nDescent = aOutMet.GetDescent();
+        }
+        m_nPrtWinAscent = o3tl::narrowing<sal_uInt16>( nAscent );
+        m_nPrtWinDescent = o3tl::narrowing<sal_uInt16>( nDescent );
+        const_cast<OutputDevice&>(rRefDev).SetFont( aOldFnt );
+    }
+    constexpr double TWIPS_PER_PIXEL = 15; // at 96 DPI
+    const double fSize = m_aFont.GetFontSize().Height() / TWIPS_PER_PIXEL;
+    if ( fSize <= 0 )
+        return false;
+    const double fScale = std::max( 1.0, std::round( fSize ) ) / fSize;
+    const auto pixels = [&]( double fTwips ) { return std::round( fTwips / TWIPS_PER_PIXEL * fScale ); };
+    const double fAscent = pixels( m_nPrtWinAscent );
+    const double fDescent = pixels( m_nPrtWinDescent );
+    rAscent = o3tl::narrowing<sal_uInt16>( fAscent * TWIPS_PER_PIXEL );
+    rHeight = o3tl::narrowing<sal_uInt16>( ( fAscent + fDescent ) * TWIPS_PER_PIXEL );
+    return true;
+}
