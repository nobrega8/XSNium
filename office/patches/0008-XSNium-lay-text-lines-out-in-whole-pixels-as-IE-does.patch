+bool vcl::font::GetWinLineMetrics(const OutputDevice& rDevice, tools::Long& rAscent, tools::Long& rDescent)
+{
+    LogicalFontInstance* pInstance = const_cast<LogicalFontInstance*>(rDevice.GetFontInstance());
+    if (!pInstance)
+        return false;
+    hb_font_t* pHbFont = pInstance->GetHbFont();
+    hb_position_t nAscent = 0, nDescent = 0;
+    if (!pHbFont
+        || !hb_ot_metrics_get_position(pHbFont, HB_OT_METRICS_TAG_HORIZONTAL_CLIPPING_ASCENT, &nAscent)
+        || !hb_ot_metrics_get_position(pHbFont, HB_OT_METRICS_TAG_HORIZONTAL_CLIPPING_DESCENT, &nDescent))
+        return false;
+    double fScale = 0;
+    pInstance->GetScale(nullptr, &fScale);
+    // As FontMetricData::ImplCalcLineSpacing: font units to device pixels, then to the device's logic units.
+    const Size aLogic = rDevice.PixelToLogic(
+        Size(0, static_cast<tools::Long>(std::round(std::abs(nAscent) * fScale))));
+    const Size aLogicDescent = rDevice.PixelToLogic(
+        Size(0, static_cast<tools::Long>(std::round(std::abs(nDescent) * fScale))));
+    rAscent = aLogic.Height();
+    rDescent = aLogicDescent.Height();
+    return rAscent + rDescent > 0;
+}
